<Project>
  <!--
    Pacote para os amigos: um Transmissor.exe só, que já leva o .NET dentro (ninguém precisa instalar nada).
    Uso, na raiz do repositório: dotnet publish app/src/Transmissor.App -p:PublishProfile=Pacote
    O .exe sai em artefatos/.
  -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <!-- Sem os .xml e .pdb das dependências: no pacote fica só o .exe -->
    <AllowedReferenceRelatedFileExtensions>.nenhuma</AllowedReferenceRelatedFileExtensions>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\..\artefatos\</PublishDir>
  </PropertyGroup>
</Project>
