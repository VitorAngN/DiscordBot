# Normaliza finais de linha no repositório (LF), independente do sistema
* text=auto eol=lf

# Scripts do Windows precisam de CRLF
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.sln text eol=crlf

# Binários
*.png binary
*.jpg binary
*.ico binary
*.wav binary
*.mp3 binary
*.ogg binary
*.exe binary
*.dll binary
